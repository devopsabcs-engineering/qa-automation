{
  "title": "Error: New service request - Ontario Common Service Centre",
  "html": "<!DOCTYPE html><html lang=\"en\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Error: New service request - Ontario Common Service Centre</title>\n    <link rel=\"stylesheet\" href=\"/css/ontario.css?v=GMKYDyzuvkw2MPbjz-joRiV40zucQD6cqGItwxSaSOc\">\n</head>\n<body>\n    <a class=\"ontario-skip-link\" href=\"#main-content\">Skip to main content</a>\n\n    <header class=\"ontario-header\" role=\"banner\">\n        <div class=\"ontario-header__container\">\n            <a class=\"ontario-header__logo\" href=\"https://www.ontario.ca\" aria-label=\"Government of Ontario\">\n                <span class=\"ontario-logo-mark\" aria-hidden=\"true\">ON</span>\n                <span class=\"ontario-logo-text\">Ontario</span>\n            </a>\n            <nav class=\"ontario-header__nav\" aria-label=\"Primary navigation\">\n                <ul>\n                    <li><a href=\"/\">Home</a></li>\n                    <li><a href=\"/Requests\">Requests</a></li>\n                    <li><a aria-current=\"page\" href=\"/Requests/New\">New request</a></li>\n                    <li><a href=\"/Privacy\">Privacy</a></li>\n                </ul>\n            </nav>\n        </div>\n        <div class=\"ontario-application-subheader\">\n            <div class=\"ontario-row\">\n                <div class=\"ontario-columns ontario-large-12\">\n                    <p class=\"ontario-application-subheader__heading\">\n                        Common Service Centre — workshop demo\n                    </p>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <main id=\"main-content\" tabindex=\"-1\" role=\"main\">\n        \n<section class=\"ontario-section\">\n    <div class=\"ontario-row\">\n        <div class=\"ontario-columns ontario-large-8\">\n            <h1 class=\"ontario-h1\">New service request</h1>\n            <p class=\"ontario-lead\">Tell us how the Common Service Centre can help.</p>\n\n                <form method=\"post\" novalidate=\"\" id=\"new-request-form\" data-testid=\"new-request-form\">\n                        <div id=\"error-summary\" class=\"ontario-error-summary\" tabindex=\"-1\" aria-labelledby=\"error-summary-title\">\n                            <h2 id=\"error-summary-title\" class=\"ontario-h3\">There is a problem</h2>\n                            <ul>\n                                    <li><a href=\"#Input_Email\">Enter your email address.</a></li>\n                                    <li><a href=\"#Input_Category\">Select a service category.</a></li>\n                                    <li><a href=\"#Input_FullName\">Enter your full name.</a></li>\n                                    <li><a href=\"#Input_Description\">Describe your request.</a></li>\n                            </ul>\n                        </div>\n\n                    <div class=\"ontario-form-group\">\n                        <label class=\"ontario-label\" for=\"Input_FullName\">Full name (required)</label>\n                        <input class=\"ontario-input input-validation-error\" autocomplete=\"name\" required=\"\" aria-describedby=\"Input_FullName-error-message\" aria-invalid=\"true\" type=\"text\" data-val=\"true\" data-val-length=\"Name must be between 2 and 100 characters.\" data-val-length-max=\"100\" data-val-length-min=\"2\" data-val-required=\"Enter your full name.\" id=\"Input_FullName\" maxlength=\"100\" name=\"Input.FullName\" value=\"\">\n                           <span id=\"Input_FullName-error-message\" class=\"ontario-error-message field-validation-error\" data-valmsg-for=\"Input.FullName\" data-valmsg-replace=\"true\">Enter your full name.</span>\n                    </div>\n\n                    <div class=\"ontario-form-group\">\n                        <label class=\"ontario-label\" for=\"Input_Email\">Email address (required)</label>\n                        <input class=\"ontario-input input-validation-error\" type=\"email\" autocomplete=\"email\" required=\"\" aria-describedby=\"Input_Email-error-message\" aria-invalid=\"true\" data-val=\"true\" data-val-email=\"Enter a valid email address.\" data-val-length=\"The field Email address must be a string with a maximum length of 200.\" data-val-length-max=\"200\" data-val-required=\"Enter your email address.\" id=\"Input_Email\" maxlength=\"200\" name=\"Input.Email\" value=\"\">\n                           <span id=\"Input_Email-error-message\" class=\"ontario-error-message field-validation-error\" data-valmsg-for=\"Input.Email\" data-valmsg-replace=\"true\">Enter your email address.</span>\n                    </div>\n\n                    <div class=\"ontario-form-group\">\n                        <label class=\"ontario-label\" for=\"Input_Category\">Service category (required)</label>\n                        <select class=\"ontario-input ontario-select input-validation-error\" required=\"\" aria-describedby=\"Input_Category-error-message\" aria-invalid=\"true\" data-val=\"true\" data-val-required=\"Select a service category.\" id=\"Input_Category\" name=\"Input.Category\">\n                            <option value=\"\" selected=\"selected\">-- Select a category --</option>\n                        <option value=\"1\">Driver and vehicle</option>\n<option value=\"2\">Health card</option>\n<option value=\"3\">Birth, marriage and death</option>\n<option value=\"4\">Business and economy</option>\n<option value=\"99\">Other</option>\n</select>\n                        <span id=\"Input_Category-error-message\" class=\"ontario-error-message field-validation-error\" data-valmsg-for=\"Input.Category\" data-valmsg-replace=\"true\">Select a service category.</span>\n                    </div>\n\n                    <div class=\"ontario-form-group\">\n                        <label class=\"ontario-label\" for=\"Input_Description\">Describe your request (required)</label>\n                        <textarea class=\"ontario-input ontario-textarea input-validation-error\" rows=\"5\" required=\"\" aria-describedby=\"Input_Description-error-message\" aria-invalid=\"true\" data-val=\"true\" data-val-length=\"Description must be between 10 and 1000 characters.\" data-val-length-max=\"1000\" data-val-length-min=\"10\" data-val-required=\"Describe your request.\" id=\"Input_Description\" maxlength=\"1000\" name=\"Input.Description\"></textarea>\n                        <span id=\"Input_Description-error-message\" class=\"ontario-error-message field-validation-error\" data-valmsg-for=\"Input.Description\" data-valmsg-replace=\"true\">Describe your request.</span>\n                    </div>\n\n                    <button id=\"submit-request\" type=\"submit\" class=\"ontario-button ontario-button--primary\">\n                        Submit request\n                    </button>\n                    <a class=\"ontario-button ontario-button--tertiary\" href=\"/\">Cancel</a>\n                <input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8Prow2VzsyJMvVScpLOwu23BgBEpoPVAG4usZv9Cgk6Lx25RpviJGyUIajlhYu1zz4CQ7kt1UyOingrs77aUyJtNw74nqKHyxrmCoTul-Em2yWwhWCMycpMXcOwR3H8klpSLux6efXngjTT0dQoLPA4\"></form>\n        </div>\n    </div>\n</section>\n\n\n    </main>\n\n    <footer class=\"ontario-footer\" role=\"contentinfo\">\n        <div class=\"ontario-row\">\n            <div class=\"ontario-columns ontario-large-12\">\n                <ul class=\"ontario-footer__links\">\n                    <li><a href=\"https://www.ontario.ca/page/accessibility\">Accessibility</a></li>\n                    <li><a href=\"https://www.ontario.ca/page/privacy-statement\">Privacy</a></li>\n                    <li><a href=\"https://www.ontario.ca/page/contact-us\">Contact us</a></li>\n                </ul>\n                <p class=\"ontario-footer__copyright\">\n                    © King's Printer for Ontario, 2012–2026 — workshop demo, not an official Government of Ontario service.\n                </p>\n            </div>\n        </div>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js\" crossorigin=\"anonymous\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js\" crossorigin=\"anonymous\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js\" crossorigin=\"anonymous\"></script>\n<script>\n        const defaultHighlight = $.validator.defaults.highlight;\n        const defaultUnhighlight = $.validator.defaults.unhighlight;\n\n        $.validator.setDefaults({\n                highlight(element, errorClass, validClass) {\n                        defaultHighlight.call(this, element, errorClass, validClass);\n                        element.setAttribute('aria-invalid', 'true');\n                },\n                unhighlight(element, errorClass, validClass) {\n                        defaultUnhighlight.call(this, element, errorClass, validClass);\n                        element.removeAttribute('aria-invalid');\n                }\n        });\n</script>\n\n    <script>\n        document.getElementById('error-summary')?.focus();\n        document.getElementById('submission-confirmation-heading')?.focus();\n    </script>\n\n\n\n</body></html>"
