@page
@model OntarioCsc.Web.Pages.Requests.NewModel
@{
    ViewData["Title"] = "New service request";
}

<section class="ontario-section">
    <div class="ontario-row">
        <div class="ontario-columns ontario-large-8">
            <h1 class="ontario-h1">New service request</h1>
            <p class="ontario-lead">Tell us how the Common Service Centre can help.</p>

            @if (Model.SubmittedReference is not null)
            {
                <div id="submission-confirmation" class="ontario-callout ontario-callout--success">
                    <h2 class="ontario-h3">Request submitted</h2>
                    <p>
                        Your reference number is <strong>@Model.SubmittedReference</strong>.
                        Keep this number for your records.
                    </p>
                    <p>
                        <a class="ontario-button ontario-button--secondary" asp-page="/Requests/Index">
                            View all requests
                        </a>
                    </p>
                </div>
            }
            else
            {
                <form method="post" novalidate id="new-request-form" data-testid="new-request-form">
                    <div asp-validation-summary="ModelOnly" class="ontario-error-summary"></div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.FullName"></label>
                        <input class="ontario-input" asp-for="Input.FullName" autocomplete="name" />
                        <span class="ontario-error-message" asp-validation-for="Input.FullName"></span>
                    </div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.Email"></label>
                        <input class="ontario-input" type="email" asp-for="Input.Email" autocomplete="email" />
                        <span class="ontario-error-message" asp-validation-for="Input.Email"></span>
                    </div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.Category"></label>
                        <select class="ontario-input ontario-select" asp-for="Input.Category" asp-items="Model.CategoryOptions">
                            <option value="">-- Select a category --</option>
                        </select>
                        <span class="ontario-error-message" asp-validation-for="Input.Category"></span>
                    </div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.Description"></label>
                        <textarea class="ontario-input ontario-textarea" rows="5" asp-for="Input.Description"></textarea>
                        <span class="ontario-error-message" asp-validation-for="Input.Description"></span>
                    </div>

                    <button id="submit-request" type="submit" class="ontario-button ontario-button--primary">
                        Submit request
                    </button>
                    <a class="ontario-button ontario-button--tertiary" asp-page="/Index">Cancel</a>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
