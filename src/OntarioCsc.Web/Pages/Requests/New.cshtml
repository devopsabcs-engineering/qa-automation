@page
@model OntarioCsc.Web.Pages.Requests.NewModel
@{
    var hasErrors = !ViewData.ModelState.IsValid;
    var fullNameInvalid = ViewData.ModelState.GetFieldValidationState("Input.FullName") == ModelValidationState.Invalid;
    var emailInvalid = ViewData.ModelState.GetFieldValidationState("Input.Email") == ModelValidationState.Invalid;
    var categoryInvalid = ViewData.ModelState.GetFieldValidationState("Input.Category") == ModelValidationState.Invalid;
    var descriptionInvalid = ViewData.ModelState.GetFieldValidationState("Input.Description") == ModelValidationState.Invalid;
    ViewData["Title"] = Model.SubmittedReference is not null
        ? "Request submitted"
        : hasErrors ? "Error: New service request" : "New service request";
}

<section class="ontario-section">
    <div class="ontario-row">
        <div class="ontario-columns ontario-large-8">
            <h1 class="ontario-h1">New service request</h1>
            <p class="ontario-lead">Tell us how the Common Service Centre can help.</p>

            @if (Model.SubmittedReference is not null)
            {
                <div id="submission-confirmation" class="ontario-callout ontario-callout--success">
                    <h2 id="submission-confirmation-heading" class="ontario-h3" tabindex="-1">Request submitted</h2>
                    <p>
                        Your reference number is <strong>@Model.SubmittedReference</strong>.
                        Keep this number for your records.
                    </p>
                    <p>
                        <a class="ontario-button ontario-button--secondary" asp-page="/Requests/Index">
                            View all requests
                        </a>
                    </p>
                </div>
            }
            else
            {
                <form method="post" novalidate id="new-request-form" data-testid="new-request-form">
                    @if (hasErrors)
                    {
                        <div id="error-summary" class="ontario-error-summary" tabindex="-1" aria-labelledby="error-summary-title">
                            <h2 id="error-summary-title" class="ontario-h3">There is a problem</h2>
                            <ul>
                                @foreach (var entry in ViewData.ModelState.Where(entry => entry.Value!.Errors.Count > 0))
                                {
                                    <li><a href="#@Html.GenerateIdFromName(entry.Key)">@entry.Value!.Errors[0].ErrorMessage</a></li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.FullName">Full name (required)</label>
                        <input class="ontario-input" asp-for="Input.FullName" autocomplete="name" required
                               aria-describedby="Input_FullName-error-message"
                               aria-invalid="@(fullNameInvalid ? "true" : null)" />
                           <span id="Input_FullName-error-message" class="ontario-error-message" asp-validation-for="Input.FullName"></span>
                    </div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.Email">Email address (required)</label>
                        <input class="ontario-input" type="email" asp-for="Input.Email" autocomplete="email" required
                               aria-describedby="Input_Email-error-message"
                               aria-invalid="@(emailInvalid ? "true" : null)" />
                           <span id="Input_Email-error-message" class="ontario-error-message" asp-validation-for="Input.Email"></span>
                    </div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.Category">Service category (required)</label>
                        <select class="ontario-input ontario-select" asp-for="Input.Category" asp-items="Model.CategoryOptions" required
                            aria-describedby="Input_Category-error-message"
                                aria-invalid="@(categoryInvalid ? "true" : null)">
                            <option value="">-- Select a category --</option>
                        </select>
                        <span id="Input_Category-error-message" class="ontario-error-message" asp-validation-for="Input.Category"></span>
                    </div>

                    <div class="ontario-form-group">
                        <label class="ontario-label" asp-for="Input.Description">Describe your request (required)</label>
                        <textarea class="ontario-input ontario-textarea" rows="5" asp-for="Input.Description" required
                                  aria-describedby="Input_Description-error-message"
                                  aria-invalid="@(descriptionInvalid ? "true" : null)"></textarea>
                        <span id="Input_Description-error-message" class="ontario-error-message" asp-validation-for="Input.Description"></span>
                    </div>

                    <button id="submit-request" type="submit" class="ontario-button ontario-button--primary">
                        Submit request
                    </button>
                    <a class="ontario-button ontario-button--tertiary" asp-page="/Index">Cancel</a>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('error-summary')?.focus();
        document.getElementById('submission-confirmation-heading')?.focus();
    </script>
}
